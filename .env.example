# MongoDB and LTI provider
MONGODB_URL=mongodb+srv://user:password@cluster.example/section_association
LTI_KEY=replace-with-a-long-random-secret
PORT=3000

# Brightspace LTI 1.3 platform registration (future admin portal shell)
BS_URL=https://tenant.brightspace.com
BS_NAME=Brightspace
BS_CLIENT_ID=your-lti-client-id
BS_AUTH_ENDPOINT=https://tenant.brightspace.com/d2l/lp/auth/login
BS_TOKEN_ENDPOINT=https://tenant.brightspace.com/d2l/lp/auth/token
BS_KEYSET_URL=https://tenant.brightspace.com/d2l/.well-known/jwks

# Brightspace Server-to-Server OAuth service account
D2L_OAUTH2_CLIENT_ID=your-service-account-client-id
D2L_OAUTH2_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
D2L_OAUTH2_KEY_ID=your-key-id
D2L_OAUTH2_TOKEN_ENDPOINT=https://auth.brightspace.com/core/connect/token
D2L_OAUTH2_SCOPES=organizations:organization:read orgunits:course:update
D2L_LP_VERSION=1.60

# Section Association cleanup
SECTION_ASSOCIATION_DRY_RUN=true
SECTION_ASSOCIATION_FAST_INTERVAL_MINUTES=15
SECTION_ASSOCIATION_STABILITY_MINUTES=10
SECTION_ASSOCIATION_RECOVERY_INTERVAL_HOURS=4
