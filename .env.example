# Database
DB_MONGODB_URL=mongodb+srv://REPLACE_USER:REPLACE_PASSWORD@REPLACE_CLUSTER/REPLACE_DATABASE?retryWrites=true&w=majority

# Application
APP_LTI_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET

# Hosting/runtime
PORT=3000

# Brightspace tenant
BS_URL=https://YOUR-TENANT.brightspace.com
BS_NAME="Your Brightspace"

# Brightspace LTI 1.3
BS_LTI_CLIENT_ID=REPLACE_WITH_LTI_CLIENT_ID
BS_LTI_DEPLOYMENT_ID=REPLACE_WITH_LTI_DEPLOYMENT_ID
BS_LTI_AUTH_ENDPOINT=https://REPLACE_WITH_PLATFORM_OIDC_AUTHENTICATION_ENDPOINT
BS_LTI_TOKEN_ENDPOINT=https://REPLACE_WITH_PLATFORM_ACCESS_TOKEN_ENDPOINT
BS_LTI_KEYSET_URL=https://REPLACE_WITH_PLATFORM_KEYSET_URL

# Brightspace OAuth2 Service Account
BS_OAUTH2_CLIENT_ID=REPLACE_WITH_OAUTH_CLIENT_ID
BS_OAUTH2_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_RSA_PRIVATE_KEY\n-----END PRIVATE KEY-----"
BS_OAUTH2_KEY_ID=REPLACE_WITH_KEY_ID
BS_OAUTH2_TOKEN_ENDPOINT=https://auth.brightspace.com/core/connect/token
BS_OAUTH2_SCOPES="organizations:organization:read orgunits:course:update"

# Brightspace API
D2L_API_LP_VERSION=1.53

# Section Association Fix
SECTION_ASSOCIATION_FIX_DRY_RUN=true
SECTION_ASSOCIATION_FIX_FAST_INTERVAL_MINUTES=15
SECTION_ASSOCIATION_FIX_STABILITY_MINUTES=10
SECTION_ASSOCIATION_FIX_RECOVERY_INTERVAL_HOURS=4
